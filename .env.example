# Local development only. Copy to .env, then replace every password with a unique value.
POSTGRES_DB=ai_manju
POSTGRES_USER=ai_manju
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5432
# Keep this password and database name synchronized with the PostgreSQL settings above.
DATABASE_URL=postgresql://ai_manju:replace-with-a-long-random-local-password@127.0.0.1:5432/ai_manju

REDIS_PASSWORD=replace-with-a-long-random-local-password
REDIS_PORT=6379

# Alibaba Cloud OSS is external to Compose. Keep the bucket private and do not
# commit real credentials. Use a dedicated RAM user's least-privilege keys.
OBJECT_STORAGE_PROVIDER=aliyun-oss
OSS_REGION=cn-shanghai
OSS_BUCKET=replace-with-your-private-bucket-name
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
OSS_SIGNED_URL_TTL_SECONDS=600

# Video-generation providers. These values are server/worker-only: do not use
# a NEXT_PUBLIC_ prefix and never commit real keys. For Wan, the workspace,
# API key, model, and region must belong to the same Model Studio region.
# The adapter derives the Model Studio base URL from WAN_WORKSPACE_ID + WAN_REGION.
WAN_API_KEY=replace-with-model-studio-api-key
WAN_WORKSPACE_ID=replace-with-model-studio-workspace-id
WAN_REGION=cn-beijing
WAN_REFERENCE_MODEL=wan2.7-r2v-2026-06-12
# Shorter than the vendor task lifetime. Signed source URLs are generated only
# in the worker and never stored in a run snapshot.
WAN_SIGNED_URL_TTL_SECONDS=900

# Optional absolute executable paths. Leave blank only when ffmpeg/ffprobe are
# available to the worker process PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Private asset IDs for the optional Shenjin single-character Wan validation
# project. Set these only after the three images have been uploaded to Studio.
SHENJIN_CHARACTER_ANCHOR_ASSET_ID=
SHENJIN_FACE_ANCHOR_ASSET_ID=
SHENJIN_STYLE_REFERENCE_ASSET_ID=

# Reserved for the later Seedance adapter. Leave the key blank until that
# provider is enabled; it is deliberately not considered by the Wan adapter.
SEEDANCE_API_KEY=
SEEDANCE_API_BASE_URL=https://ark.cn-beijing.volces.com
SEEDANCE_MODEL=replace-after-model-activation
